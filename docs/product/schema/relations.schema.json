{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ascent-of-karl.local/schema/relations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "edges": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$"
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "relation",
        "rationale",
        "provenance"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/nodeId"
        },
        "target": {
          "$ref": "#/$defs/nodeId"
        },
        "relation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "provenance": {
          "const": "CURATED"
        }
      }
    }
  }
}
