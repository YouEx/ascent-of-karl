{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ascent-of-karl.local/schema/known-answers.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "queries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "queries": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/query"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9_.@/-]+$"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "expectedCapabilities",
        "requiredNodes",
        "requiredSources",
        "requiredTerms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "question": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "expectedCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          }
        },
        "requiredNodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "requiredSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        },
        "requiredTerms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}
