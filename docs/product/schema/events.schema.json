{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ascent-of-karl.local/schema/events.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storageKey",
    "maxEntries",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "storageKey": {
      "const": "karl-product-events-v1"
    },
    "maxEntries": {
      "type": "integer",
      "minimum": 100,
      "maximum": 1000
    },
    "events": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability",
        "scenarios",
        "description",
        "payloadRequired"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "capability": {
          "$ref": "#/$defs/id"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "payloadRequired": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          }
        }
      }
    }
  }
}
