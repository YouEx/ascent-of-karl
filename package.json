{
  "name": "the-ascent-of-karl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Story-drevet alchemy-spil med en sarkastisk fortæller",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run typecheck:worker && vite build && node tools/bundle_budget.mjs",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "python3 tools/validate.py",
    "predicates": "python3 tools/predicate_report.py",
    "predicates:fixture": "python3 tools/parity_fixture.py",
    "verdicts": "vite-node tools/verdict_report.ts",
    "ux": "node tools/ux_audit.mjs",
    "art": "python3 tools/art/build_all.py",
    "social": "node tools/social/render.mjs",
    "judge:capture": "node tools/judge/capture.mjs",
    "judge:score": "python3 tools/judge/metrics.py",
    "judge:report": "python3 tools/judge/overlay.py",
    "judge:apply": "node tools/judge/apply.mjs",
    "judge:determinism": "node tools/judge/determinism.mjs",
    "judge": "npm run judge:capture && npm run judge:score && npm run judge:report",
    "pairs": "vite-node tools/pair_frequency.ts",
    "pairs:prepare": "vite-node tools/prepare_pairs.ts",
    "pairs:assemble": "python3 tools/assemble_pairs.py",
    "coverage": "node tools/coverage_report.mjs",
    "bundle-budget": "node tools/bundle_budget.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^9.1.0"
  }
}
