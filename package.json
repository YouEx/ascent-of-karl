{
  "name": "the-ascent-of-karl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Story-drevet alchemy-spil med en sarkastisk fort\u00e6ller",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "python3 tools/validate.py",
    "predicates": "python3 tools/predicate_report.py",
    "predicates:fixture": "python3 tools/parity_fixture.py",
    "ux": "node tools/ux_audit.mjs",
    "social": "node tools/social/render.mjs",
    "judge:capture": "node tools/judge/capture.mjs",
    "judge:score": "python3 tools/judge/metrics.py",
    "judge:report": "python3 tools/judge/overlay.py",
    "judge:apply": "node tools/judge/apply.mjs",
    "judge": "npm run judge:capture && npm run judge:score && npm run judge:report"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^9.1.0"
  }
}
