{
  "name": "the-ascent-of-karl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Story-drevet alchemy-spil med en sarkastisk fortæller",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check:svelte && npm run typecheck:worker && vite build && node tools/bundle_budget.mjs",
    "build:pages": "tsc --noEmit && npm run check:svelte && npm run typecheck:worker && node tools/build_pages.mjs",
    "pages:verify": "node tools/verify_pages_artifact.mjs",
    "verify:pages": "node tools/verify_pages_artifact.mjs",
    "verify:live": "node tools/verify_live_deploy.mjs",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "playtest:evidence:check": "node docs/playtest/task-030-improvisation-agent-qa-2026-08-13/verify-evidence.mjs",
    "validate": "python3 tools/validate.py",
    "predicates": "python3 tools/predicate_report.py",
    "predicates:fixture": "python3 tools/parity_fixture.py",
    "improvise:report": "vite-node tools/improvise_report_cli.ts",
    "improvise:report:check": "vite-node tools/improvise_report_check_cli.ts",
    "voice:profile": "python3 tools/voice/export_worker_profile.py",
    "voice:parity-fixture": "python3 tools/voice/export_voice_parity_fixture.py",
    "verdicts": "vite-node tools/verdict_report.ts",
    "ux": "node tools/ux_audit.mjs",
    "audit:narration": "node tools/narration_audit.mjs",
    "art": "python3 tools/art/build_all.py",
    "social": "node tools/social/render.mjs",
    "judge:capture": "node tools/judge/capture.mjs",
    "judge:score": "python3 tools/judge/metrics.py",
    "judge:report": "node tools/judge/report.mjs",
    "judge:apply": "node tools/judge/apply.mjs",
    "judge:determinism": "node tools/judge/determinism.mjs",
    "judge:title-fidelity": "node tools/judge/title-fidelity.mjs",
    "judge": "node tools/judge/loop.mjs",
    "judge:once": "node tools/judge/loop.mjs --max 1",
    "pairs": "vite-node tools/pair_frequency.ts",
    "pairs:prepare": "vite-node tools/prepare_pairs.ts",
    "pairs:export": "node tools/live_pair_export.mjs",
    "harvest": "node tools/harvest.mjs",
    "pairs:assemble": "python3 tools/assemble_pairs.py",
    "coverage": "node tools/coverage_report.mjs",
    "bundle-budget": "node tools/bundle_budget.mjs",
    "product:validate": "node tools/product-knowledge/validate.mjs",
    "product:graph": "node tools/product-knowledge/export.mjs",
    "product:graph:check": "node tools/product-knowledge/export.mjs --check",
    "product:graph:enrich": "node tools/product-knowledge/enrich.mjs",
    "product:context": "node tools/product-knowledge/context.mjs",
    "product:known-answers": "node tools/product-knowledge/known-answers.mjs",
    "product:generate": "node tools/product-knowledge/generate-contracts.mjs",
    "product:generate:check": "node tools/product-knowledge/generate-contracts.mjs --check",
    "product:check": "npm run product:validate && npm run product:generate:check && npm run completion:check && npm run product:graph:check && npm run product:known-answers",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "completion:generate": "node tools/generate_completion_manifest.mjs",
    "completion:check": "node tools/generate_completion_manifest.mjs --check",
    "parity:capture": "node tools/parity/capture.mjs",
    "parity:check": "node tools/parity/compare.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "playwright": "^1.62.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^9.1.0"
  }
}
