  "usikre": [
    {
      "id": "roegsignaler",
      "hvorfor": "Intet trait fanger 'signal/besked'. 'hot' er fjernet igen — den lod røgsignaler løse Karls kulde og ulve på landskabsskala, hvilket er absurd (et signalbål på en fjern bakke varmer ikke Karl). 'sacred' og 'healing' passer heller ikke (det er kommunikation, ikke tro eller helbredelse). 'light' bruges nu som en sikker, sand, men svag erstatning."
    },
    {
      "id": "syner",
      "hvorfor": "Hallucination har intet matchende trait. 'hot' er fjernet — den lod synerne kurere feber og skræmme ulve, samme bivirkning som ind-i-maleriet havde. Adskilt fra det ægte ritual/helligsted-spor (spor:'komisk', shaman+grottebryg = fuld tur, ikke tro), så 'sacred' er bevidst fravalgt. 'light' (svimmel/svævende) valgt i stedet."
    },
    {
      "id": "knoglekast",
      "hvorfor": "En engangshændelse uden fysisk substans at tagge (kind:phenomenon, stuff:none). 'loud' er et svagt gæt på knoglens nedslag på Ugh."
    },
    {
      "id": "modeshow",
      "hvorfor": "Optræden/kåring har intet dedikeret trait. 'loud' er nærmeste tilgængelige, men catwalken beskrives ikke som støjende — kun bedømt ('det er en 4')."
    },
    {
      "id": "drive-in",
      "hvorfor": "Scenen er eksplicit stille ('watch them in silence... shushes the boar'), så 'loud' passer ikke selvom resten af gruppen (koncert, trommesolo) er det. 'portable' vælges løst via footmobilen, men begrundelsen er svag."
    },
    {
      "id": "trafikprop",
      "hvorfor": "Ingen trait fanger 'blokade/kø-standoff'. 'loud' antaget via frustration/skænderi, men ikke eksplicit i teksten."
    },
    {
      "id": "stenspil",
      "hvorfor": "Et roligt terningspil-lignende spil (boules) — 'loud' er nærmeste tilgængelige trait, men er svagt begrundet for en stille aktivitet."
    },
    {
      "id": "fjer",
      "hvorfor": "'Feather' har ingen dedikeret stuff-værdi i ordforrådet. 'fibre' er valgt som nærmeste (fjer er hverken tydeligt plante- eller kødbaseret i ordforrådets forstand); samme antagelse er brugt for 'vinger'."
    },
    {
      "id": "floejte",
      "hvorfor": "Instrument-spørgsmål: en benfløjte løser ikke 'Bare hands' (den hugger, graver eller jager ikke noget) — kind=tool ville fejlagtigt lade den løse værktøjsmangel, ligesom festdragt og vinger gjorde før rettelsen. Valgt kind=material (samme skuffe som festdragt/dunkappe: et færdigt fysisk objekt, ikke et arbejdsredskab). Traits beholder 'loud' (den spiller toner, matcher tromme-præcedens for det trait). Samme afgørelse bør bruges på tromme og maske i de andre batches — begge er nu tagget kind=tool og har samme fejl (tromme har allerede 'loud', som kan bevares)."
    }
  ]
}
